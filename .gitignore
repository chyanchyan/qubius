node_modules/
# 安装依赖前的备份（deploy/build.sh / deploy-job.mjs 的回滚路径）。
node_modules.prev
dist/
data/
/config.yaml
/config-secondary.yaml
# 直接把配置放在 checkout 根目录时（Windows 上常见），部署页和服务会在旁边
# 生成配置备份、env、部署状态和凭据；这些运行时文件同样不提交。默认位置
# .qubius/ 已经整目录忽略。
/config.yaml.bak*
/config-secondary.yaml.bak*
/projects.yaml.bak*
/env
/env.bak*
/env.*.local
/deploy.json
/edge.json
/ops.meta
/lan-proxy.credentials
/deploy/env
/deploy/env.bak.*
/deploy/env.*.local
# 默认配置、env、数据和日志都收敛在仓库内的这一个目录，不提交。
/.qubius/
*.log
.DS_Store
web/dist/
server/dist/
# staging / 回滚目录：build.sh 先构建到 .next 再原子切换，旧产物留作 .prev。
# 必须忽略，否则所有 dirty 检查（git status -- server web）会把它们当源码改动。
web/dist.next
web/dist.prev
server/dist.next
server/dist.prev
# 回滚时临时改名目录（被强杀可能残留）。
server/dist.rollback.*
web/dist.rollback.*
*.tsbuildinfo
scripts/push-github-squashed.sh
projects.yaml