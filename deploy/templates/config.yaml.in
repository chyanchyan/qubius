# qubius 配置（由 deploy/install.sh 渲染，不要手工编辑）。
# 默认不覆盖已存在的配置：install.sh 只把新渲染结果与旧文件比较，差异备份为
# *.bak.<时间戳>。要让新 env 生效，可以运行 install.sh --force-config（页面部署
# 会这样调用），或手工编辑本文件，或删除/移走后再重新运行 install.sh。
# 实例：{{QUBIUS_INSTANCE}}（{{QUBIUS_ROLE}}）
role: {{QUBIUS_ROLE}}
{{QUBIUS_CFG_SECONDARY_BLOCK}}
listen: 127.0.0.1:{{QUBIUS_PORT}}
dataDir: {{QUBIUS_CFG_DATA_DIR}}
allowedHosts: [127.0.0.1, localhost, "[::1]", {{QUBIUS_CFG_PUBLIC_HOST}}]
maxConcurrent: {{QUBIUS_MAX_CONCURRENT}}
# limits 可选，不写时使用默认值；也可以用环境变量覆盖（见 README）。
# limits:
#   transcriptBytes: 8388608
#   transcriptMessages: 5000
#   messageText: 200000
#   requestBodyBytes: 28000000
#   historyPage: 200
{{QUBIUS_CFG_ARCHIVE_BLOCK}}
{{QUBIUS_CFG_PROJECTS_SECTION}}
